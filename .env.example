APP_NAME=InternTrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Include the port the API is actually served on. The `public` filesystem disk
# derives avatar URLs from this value, so a bare http://localhost makes every
# uploaded profile photo 404 in the browser (port 80 is whatever local stack you
# have there — Laragon/XAMPP Apache — not `php artisan serve`).
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# Vue dev server origin — used by config/cors.php
FRONTEND_URL=http://localhost:5173

# Sanctum: domains that should receive stateful (cookie-session) API auth.
# Add your production web domain here too once deployed.
SANCTUM_STATEFUL_DOMAINS=localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outbound mail. Used by the daily "missing journal entry" reminder, which mails
# ONLY students whose address has been verified through Google — everyone else
# gets the in-app notification alone.
#
# `log` is the committed default on purpose: a fresh clone writes the rendered
# message to storage/logs/laravel.log and sends nothing, so nobody accidentally
# emails real students while developing. Switch to `smtp` to send for real.
#
# Mailtrap / Mailpit (recommended for a demo — catches mail in a web inbox):
#   MAIL_MAILER=smtp
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#   MAIL_USERNAME=<from your Mailtrap inbox>
#   MAIL_PASSWORD=<from your Mailtrap inbox>
#
# Gmail with an App Password (needs 2FA on the account; a normal password is
# rejected). Note Gmail overrides the from address to the authenticated account:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_SCHEME=null   # NOT "tls" — Symfony Mailer only accepts smtp/smtps; 587 does STARTTLS on its own
#   MAIL_USERNAME=<your.address@gmail.com>
#   MAIL_PASSWORD=<16-character app password, no spaces>
#
# Resend (no SMTP credentials, but it REQUIRES a domain you can add SPF/DKIM DNS
# records to — its shared resend.dev sender only delivers to your own account
# address, so it cannot reach students). Needs `composer require resend/resend-php`:
#   MAIL_MAILER=resend
#   RESEND_API_KEY=re_xxxxxxxx
#
# Reminders also need the API host to run `schedule:run` every minute. No queue
# worker is required — MissingJournalEntryReminder does not implement ShouldQueue
# and sends inline. Vercel cannot run cron; see the deployment notes in CLAUDE.md.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Fallback sender. The admin's System Settings "System Email", when set, wins
# over this for reminder mail.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where the landing page's public contact form delivers. Leave BLANK and that
# form answers 503 ("not configured yet") instead of accepting messages that go
# nowhere. Server-side only — it is never sent to the browser.
MDC_COORDINATOR_EMAIL=

# Google OAuth. Used for TWO things only: proving a user owns an email address
# ("Verify with Google" in Edit Profile), and signing in an account whose address
# was already proven that way. It never creates an account and never assigns a
# role — accounts are staff-provisioned, so an unrecognised Google address is
# rejected rather than registered.
#
# Setup (Google Cloud Console, https://console.cloud.google.com):
#   1. Create a project.
#   2. APIs & Services > OAuth consent screen > External. Add your app name and
#      support email. Scopes are `email` + `profile`, both NON-SENSITIVE, so no
#      Google app review is needed to publish.
#      While the screen is in "Testing", every tester's Gmail must be added under
#      "Test users" (100 max) or their sign-in is refused.
#   3. APIs & Services > Credentials > Create credentials > OAuth client ID >
#      **Web application**.
#   4. Under "Authorized redirect URIs" add EXACTLY (scheme, host and port must
#      match GOOGLE_REDIRECT_URI below):
#         http://localhost:8000/auth/google/callback
#      Add the production API URL there too once the API is deployed.
#   5. Copy the client ID and secret into the two values below.
#
# Leaving these blank simply disables the Google buttons; username + password
# login is unaffected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shared secret for POST|GET /api/cron/run, which lets a free external scheduler
# (cron-job.org, UptimeRobot) run the jobs in routes/console.php on a host with
# no cron of its own. Leaving it BLANK disables the endpoint entirely (it 404s)
# rather than leaving it open. Generate with:
#   php -r "echo bin2hex(random_bytes(24));"
CRON_SECRET=

# ---------------------------------------------------------------------------
# Company-location map (Student Information Sheet — "Sketch of Internship
# Company Location")
# ---------------------------------------------------------------------------
# The student pins their company on a map; the server stitches the raster tiles
# covering that point into the sketch box on the PDF.
#
# OpenStreetMap is the default because it needs NO key, NO account and NO card.
# Google Maps (including its Static Maps API) requires a billing account with a
# payment method even inside the free credit, which this deployment cannot do.
#
# Any {z}/{x}/{y} raster endpoint works, so a keyed or paid provider is a
# one-line swap with no code change.
#
# STATIC_MAP_ENABLED=false switches the whole feature off: the picker hides and
# every sheet prints the blank box the paper form has always carried.
STATIC_MAP_ENABLED=true
STATIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"

# REQUIRED by the OpenStreetMap tile and Nominatim usage policies — an
# unidentified caller is blocked, and the symptom is a silently empty map.
# Put a real contact in here for a deployment you own.
STATIC_MAP_USER_AGENT="InternTrack/1.0 (MDC SIPP OJT monitoring; capstone project)"
STATIC_MAP_ATTRIBUTION="(c) OpenStreetMap contributors"

# Where the picker opens before anything is pinned (Mater Dei College, Tubigon).
STATIC_MAP_DEFAULT_LAT=9.9483
STATIC_MAP_DEFAULT_LNG=123.9622
STATIC_MAP_DEFAULT_ZOOM=13
