# =============================================================================
# InternTrack — API environment for a DEPLOYED instance.
#
# Copy the values into your host's environment/secrets UI. Do NOT commit a
# filled-in copy of this file: .env is gitignored, this template is not.
#
# This covers the API half only. The Vue SPA deploys separately to Vercel and
# has exactly one build-time variable of its own (VITE_BACKEND_URL, noted at the
# bottom).
# =============================================================================

APP_NAME=InternTrack
APP_ENV=production

# Generate ONE key and keep it stable. `php artisan key:generate --show` prints
# one without writing a file. Changing it later invalidates every existing
# session and every encrypted value — including the Google OAuth state payload.
APP_KEY=

# MUST be false. AppServiceProvider throws a RuntimeException when APP_ENV is
# production and this is true, precisely because .env.example ships it as true
# for local dev and that value is easy to carry over by accident.
APP_DEBUG=false

# The API's OWN public origin, including the scheme. Not the SPA's.
# Used for absolute URL generation and, when AVATAR_DISK=public, for building
# avatar URLs — so a wrong value here shows up as broken profile photos.
APP_URL=https://your-api-host.example.com

# Every user of this system is in the Philippines (UTC+8). Leave this unset and
# the server runs on UTC, where anything before 08:00 Manila still reads as
# YESTERDAY — the journal calendar offers the wrong date, "this week" counts are
# off, and per-student reminder hours fire 8 hours early.
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# `debug` is far too chatty for a deployed app: GoogleController logs every
# entry-point and callback hit at info level.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# MySQL. Do NOT use sqlite on a host with an ephemeral filesystem — the whole
# database would be discarded on every deploy.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=interntrack
DB_USERNAME=
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Frontend origin, CORS and Sanctum
# -----------------------------------------------------------------------------
# The SPA's deployed origin, scheme included. config/cors.php pins
# allowed_origins to exactly this, and the Google OAuth flow bounces the browser
# back into the app using it.
FRONTEND_URL=https://your-app.vercel.app

# Host(s) that get stateful (cookie-session) API auth. HOST ONLY — no scheme,
# no trailing slash. Comma-separated for several.
#
# Sanctum decides "is this the frontend?" from the request's Referer/Origin, NOT
# from the Host it was served on. With the Vercel rewrite proxy in front, the
# browser believes it is talking to the Vercel domain and sends that as Referer,
# so THIS is the value that makes login work at all. Get it wrong and every
# authenticated request 401s while /login itself appears to succeed.
SANCTUM_STATEFUL_DOMAINS=your-app.vercel.app

# -----------------------------------------------------------------------------
# Session cookies
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# Leave EMPTY. An empty domain makes the session cookie host-only, which is what
# lets it attach to the Vercel domain the browser thinks it is talking to
# through the rewrite proxy. Setting it to the API's domain breaks login.
SESSION_DOMAIN=

# HTTPS only. Non-negotiable for a public deployment.
SESSION_SECURE_COOKIE=true

# `lax` is correct BECAUSE of the rewrite-proxy model: the browser sees
# same-origin requests, so the cookie is first-party and Lax applies cleanly. It
# also still rides the top-level GET redirect back from accounts.google.com.
#
# Only switch to `none` if you abandon the proxy and call the API cross-domain —
# and be aware that makes login depend on third-party cookies, which Safari and
# hardened browsers block outright.
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Queue, cache, broadcasting
# -----------------------------------------------------------------------------
# `sync` on purpose. Nothing in this codebase implements ShouldQueue and there
# is no app/Jobs directory, so no worker is needed. Choosing `database` without
# running a worker would mean anything queued later silently never runs; `sync`
# executes it inline instead. Revisit only when a real queue worker exists.
QUEUE_CONNECTION=sync

CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Avatar storage
# -----------------------------------------------------------------------------
# "public" writes to storage/app/public and needs `php artisan storage:link`.
# That is only safe on a host with a PERSISTENT disk (a VPS, or a mounted
# volume). On a container host that rebuilds per deploy, uploaded profile photos
# vanish on the next deploy — set this to "r2" instead.
AVATAR_DISK=public

# Cloudflare R2 (S3-compatible). Only needed when AVATAR_DISK=r2.
#   R2_DEFAULT_REGION must be "auto".
#   R2_ENDPOINT      https://<account-id>.r2.cloudflarestorage.com
#   R2_URL           the bucket's PUBLIC read URL — required, because
#                    User::avatarUrl() hands it straight to an <img> tag. Enable
#                    public access on the bucket (r2.dev URL or custom domain).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# Only the daily missing-journal reminder sends mail, and only to students whose
# address Google itself verified. `log` sends nothing at all, which is the right
# default until you have real SMTP credentials — a fresh deployment then cannot
# accidentally email real students.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-domain.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
# Leaving these blank cleanly disables both Google buttons ("not set up on this
# server yet"); username + password login is unaffected.
#
# GOOGLE_REDIRECT_URI must point at the SPA's origin, NOT the API's, whenever
# the Vercel rewrite proxy is in play — and the exact same string must be
# registered under "Authorized redirect URIs" on the OAuth client.
#
# Why the SPA origin: the callback signs the user in, and the browser stores
# that session cookie against whichever host it thinks it called. Send Google to
# the API host directly and the cookie lands on the API's domain, while the SPA
# reads the Vercel domain — the sign-in silently appears to fail.
#
# While the consent screen is in "Testing", every tester's Gmail must be listed
# under "Test users" or their sign-in is refused.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/auth/google/callback

# -----------------------------------------------------------------------------
# First admin account (read by ProductionSeeder)
# -----------------------------------------------------------------------------
# Consumed by:  php artisan db:seed --class=ProductionSeeder --force
#
# Do NOT run `db:seed` with no --class on a deployment: DatabaseSeeder calls
# twelve DEMO seeders and creates ~30 fictional accounts whose shared password
# is documented in this repo's public CLAUDE.md.
#
# ProductionSeeder refuses to run without both values and rejects a password
# under 12 characters. Delete these two after the first successful seed.
ADMIN_NAME="System Administrator"
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# =============================================================================
# SPA (Vercel) — set in the Vercel project, not here
# =============================================================================
# VITE_BACKEND_URL=https://your-api-host.example.com
#
# Only read at BUILD time, and only by web/src/lib/googleAuth.ts for the two
# Google entry-point links. Everything else goes through the same-origin
# rewrites in web/vercel.json. Changing it requires a redeploy, not a restart.
