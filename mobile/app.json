{
  "expo": {
    "name": "InternTrack",
    "slug": "interntrack-mobile",
    "scheme": "interntrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mdc.interntrack"
    },
    "android": {
      "package": "com.mdc.interntrack",
      "adaptiveIcon": {
        "backgroundColor": "#0a1628"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8e4c1694-b304-4463-8406-5eb160a63593"
      }
    },
    "owner": "karlo1090s-team"
  }
}
