{
  "expo": {
    "name": "InternTrack",
    "slug": "interntrack-mobile",
    "scheme": "interntrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mdc.interntrack"
    },
    "android": {
      "package": "com.mdc.interntrack",
      "adaptiveIcon": {
        "backgroundColor": "#20304c",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#20304c"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "InternTrack uses the camera to scan your workplace Daily Time Record QR code."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "InternTrack records your location when you clock in or out, to confirm you are at your assigned workplace."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "InternTrack needs access to your photos so you can choose a profile picture."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8e4c1694-b304-4463-8406-5eb160a63593"
      }
    },
    "owner": "karlo1090s-team",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/8e4c1694-b304-4463-8406-5eb160a63593",
      "fallbackToCacheTimeout": 0
    }
  }
}
